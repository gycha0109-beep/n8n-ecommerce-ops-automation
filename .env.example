# n8n 2.37.7 reference setup
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Seoul
TZ=Asia/Seoul

# PostgreSQL / Supabase-compatible connection
POSTGRES_DB=ecommerce_ops
POSTGRES_USER=ecommerce_ops
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Mock integrations
MOCK_API_BASE_URL=http://mock-api:3000
ALERT_WEBHOOK_URL=http://mock-api:3000/api/notify
